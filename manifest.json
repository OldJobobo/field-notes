{
  "schemaVersion": 1,
  "id": "jobo.field-notes",
  "name": "Field Notes",
  "version": "0.1.3",
  "author": "OldJobobo",
  "license": "MIT",
  "description": "A floating notebook for sketches and typed notes, with graph, dot and ruled paper.",
  "kinds": [
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Field Notes",
    "description": "Open the floating graph-paper notebook",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
